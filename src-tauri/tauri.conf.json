{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "桌面日历融合预览",
  "mainBinaryName": "DesktopCalendarFusion",
  "version": "1.1.20",
  "identifier": "pro.softsoft.li-calendar.weather-fusion-preview",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "removeUnusedCommands": true
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "桌面日历",
        "width": 800,
        "height": 600,
        "center": true,
        "resizable": true,
        "visible": false,
        "decorations": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../THIRD_PARTY_WEATHER.md": "THIRD_PARTY_WEATHER.md"
    },
    "createUpdaterArtifacts": false,
    "publisher": "softsoft.pro",
    "category": "Utility",
    "shortDescription": "桌面日历 V14.8 横向双栏预览",
    "longDescription": "桌面日历 V14.8：左侧三地点天气与右侧六行月历、宜忌的一体化横版布局",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
